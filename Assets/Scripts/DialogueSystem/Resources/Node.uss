DialogueNode #title{
	background-color: rgb(15, 90, 15);
}

ChoiceNode #title{
	background-color: rgb(15, 15, 90);

}

AffinityNode #title{
	background-color: rgb(120, 15, 60);

}

ConditionPropertyNode #title{
	background-color: rgb(90, 15, 15);

}

NoteNode #title{
	background-color: rgb(150, 125, 15);

}

SetPropertyNode #title{
	background-color: rgb(15, 120, 100);

}

ThinkingNode #title{
	background-color: rgb(145, 115, 190);
	color: rgb(0, 0, 0);
}

UnlockNode #title{
	background-color: rgb(150, 150, 150);
	color: rgb(0, 0, 0);
}

BlockNode #title{
	background-color: rgb(180, 10, 10);
}

NewApplicationNode #title{
	background-color: rgb(118, 118, 153);
}

AffinityNode #title-label,
BlockNode #title-label,
ChoiceNode #title-label,
ConditionPropertyNode #title-label,
DialogueNode #title-label,
NoteNode #title-label,
SetPropertyNode #title-label,
NewApplicationNode #title-label {
	-unity-font-style: bold;
}


ThinkingNode #title-label,
UnlockNode #title-label{
	color: rgb(0, 0, 0);
	-unity-font-style: bold;
}

.unity-base-popup-field__input{
	border-radius: 10px;
}

.unity-base-popup-field__text {
    -unity-text-align: middle-center;
}

#deleteButton{
	background-color: rgb(0, 0, 0);
	color: rgb(255, 255, 255);
}